# Godot 4+ specific ignores
.godot/
*.translation
export.cfg
# export_presets.cfg IS committed -- headless CI export needs the Web preset.

# Imported resources
*.import

# Mono / C# (just in case)
.mono/
data_*/
mono_crash.*.json

# System / OS
.DS_Store
Thumbs.db
*.tmp
*.log

# IDE
.vscode/
.idea/
*.swp
*~

# Emoji fallback font: fetched by CI at build time, not committed (see
# autoload/font_setup.gd). Desktop falls back to system emoji fonts.
assets/fonts/*.ttf
assets/fonts/*.otf

# Builds / exports
build/
builds/
export/
*.exe
*.pck
*.zip
*.app
*.x86_64
