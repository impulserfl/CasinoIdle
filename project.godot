; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but the contents can be safely modified manually.

config_version=5

[application]

config/name="CasinoIdle"
config/description="Incremental idle casino sim with interactive tables, prestige, and a midnight-gold floor."
config/version="1.0.0"
run/main_scene="res://scenes/title.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

AudioManager="*res://autoload/audio_manager.gd"
Settings="*res://autoload/settings.gd"
GameManager="*res://autoload/game_manager.gd"
Upgrades="*res://autoload/upgrades.gd"
GameUpgrades="*res://autoload/game_upgrades.gd"
Casino="*res://autoload/casino.gd"
Achievements="*res://autoload/achievements.gd"
Events="*res://autoload/events.gd"
SaveManager="*res://autoload/save_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=800
window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[importer_defaults]

texture={
"compress/mode": 0,
"mipmaps/generate": true,
"process/fix_alpha_border": true
}

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.web="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/anisotropic_filtering_level=2
