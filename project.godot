; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but the contents can be safely modified manually.

config_version=5

[application]

config/name="CasinoIdle"
config/description="Incremental idle casino sim: run a casino floor for passive income, gamble across 18 tables for EXP and jackpots, prestige for permanent bonuses."
config/version="0.5.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

FontSetup="*res://autoload/font_setup.gd"
AudioManager="*res://autoload/audio_manager.gd"
Settings="*res://autoload/settings.gd"
GameManager="*res://autoload/game_manager.gd"
Upgrades="*res://autoload/upgrades.gd"
GameUpgrades="*res://autoload/game_upgrades.gd"
Casino="*res://autoload/casino.gd"
Achievements="*res://autoload/achievements.gd"
Events="*res://autoload/events.gd"
SaveManager="*res://autoload/save_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=800
window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.web="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
